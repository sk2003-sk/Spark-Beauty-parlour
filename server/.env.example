PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/spark-beauty
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# Comma separated list of allowed website addresses
CLIENT_URL=http://localhost:5173
TIMEZONE=Asia/Kolkata
OPEN_HOUR=10
CLOSE_HOUR=20
# How many customers can book the same hour
SLOT_CAPACITY=2
BOOKING_WINDOW_DAYS=14
# Used by npm run seed to create the owner login
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=ChangeThisPassword1
ADMIN_PHONE=8500512643
